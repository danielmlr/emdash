---
import { getEmDashEntry, decodeSlug } from "emdash";
import { PortableText } from "emdash/ui";
import Base from "../../layouts/Base.astro";

const slug = decodeSlug(Astro.params.slug);

if (!slug) {
	return Astro.rewrite("/404");
}

const { entry: job, cacheHint } = await getEmDashEntry("jobs", slug);

if (!job) {
	return Astro.rewrite("/404");
}

Astro.cache.set(cacheHint);
---

<Base title={job.data.title} content={{ collection: "jobs", id: job.data.id, slug }}>
	<article class="job-article">
		<p class="job-back"><a href="/jobs">← All jobs</a></p>
		<header class="job-header">
			<h1 class="job-title" {...job.edit.title}>{job.data.title}</h1>
			<p class="job-meta">
				{[job.data.location, job.data.employment].filter(Boolean).join(" · ")}
			</p>
		</header>
		<div class="job-content">
			<PortableText value={job.data.description} />
		</div>
	</article>
</Base>

<style>
	.job-article {
		max-width: var(--max-width);
		margin: 0 auto;
		padding: var(--spacing-16) var(--spacing-6);
	}

	.job-back {
		margin-bottom: var(--spacing-6);
		font-size: var(--font-size-sm);
	}

	.job-title {
		font-size: clamp(var(--font-size-2xl), 4vw, var(--font-size-4xl));
		font-weight: 700;
		line-height: var(--leading-tight);
	}

	.job-meta {
		margin-top: var(--spacing-2);
		color: var(--color-muted);
	}

	.job-content {
		margin-top: var(--spacing-8);
	}

	.job-content :global(p) {
		margin-bottom: 1.5em;
	}
</style>
