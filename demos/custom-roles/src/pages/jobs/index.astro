---
import { getEmDashCollection } from "emdash";
import Base from "../../layouts/Base.astro";

const { entries: jobs, cacheHint } = await getEmDashCollection("jobs", {
	orderBy: { published_at: "desc" },
});

Astro.cache.set(cacheHint);
---

<Base title="Jobs" description="Open positions">
	<div class="jobs-page">
		<header class="page-header">
			<h1 class="page-title">Jobs</h1>
			<p class="page-lead">Open positions. Maintained by the jobs team in the admin.</p>
		</header>

		{
			jobs.length === 0 ? (
				<p class="empty">No open positions right now.</p>
			) : (
				<ul class="jobs-list">
					{jobs.map((job) => (
						<li class="job-item">
							<a href={`/jobs/${job.id}`} class="job-link">
								<span class="job-title">{job.data.title}</span>
								<span class="job-meta">
									{[job.data.location, job.data.employment].filter(Boolean).join(" · ")}
								</span>
							</a>
						</li>
					))}
				</ul>
			)
		}
	</div>
</Base>

<style>
	.jobs-page {
		max-width: var(--max-width);
		margin: 0 auto;
		padding: var(--spacing-16) var(--spacing-6);
	}

	.page-header {
		margin-bottom: var(--spacing-8);
	}

	.page-title {
		font-size: clamp(var(--font-size-2xl), 4vw, var(--font-size-4xl));
		font-weight: 700;
		line-height: var(--leading-tight);
	}

	.page-lead {
		margin-top: var(--spacing-2);
		color: var(--color-muted);
	}

	.jobs-list {
		list-style: none;
		padding: 0;
		display: grid;
		gap: var(--spacing-4);
	}

	.job-link {
		display: grid;
		gap: var(--spacing-1);
		padding: var(--spacing-4) var(--spacing-5);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-md, 8px);
		color: inherit;
		text-decoration: none;
	}

	.job-link:hover {
		border-color: var(--color-text);
	}

	.job-title {
		font-weight: 600;
		font-size: var(--font-size-lg);
	}

	.job-meta {
		color: var(--color-muted);
		font-size: var(--font-size-sm);
	}
</style>
